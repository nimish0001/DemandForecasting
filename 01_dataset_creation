
import pandas as pd
import numpy as np
from pathlib import Path

# ==================================================
# 1. SETTINGS
# ==================================================
np.random.seed(42)

n_records = 1800

start_date = "2023-01-01"
end_date = "2025-12-31"

dates = pd.to_datetime(
    np.random.choice(
        pd.date_range(start_date, end_date, freq="D"),
        size=n_records
    )
)

# ==================================================
# 2. LOGISTICS CATEGORIES
# ==================================================
routes = [
    "Lucknow-Delhi",
    "Delhi-Mumbai",
    "Lucknow-Kanpur",
    "Mumbai-Pune",
    "Delhi-Jaipur",
    "Kanpur-Varanasi"
]

route_regions = {
    "Lucknow-Delhi": "North",
    "Delhi-Mumbai": "West",
    "Lucknow-Kanpur": "North",
    "Mumbai-Pune": "West",
    "Delhi-Jaipur": "North",
    "Kanpur-Varanasi": "North"
}

transport_modes = ["Truck", "Rail", "Air"]
cargo_types = ["Electronics", "Food", "Textiles", "Machinery"]

# ==================================================
# 3. GENERATE BASE DATASET
# ==================================================
df = pd.DataFrame({
    "shipment_id": range(1001, 1001 + n_records),
    "shipment_date": dates,
    "route": np.random.choice(routes, n_records),
    "transport_mode": np.random.choice(
        transport_modes, n_records, p=[0.65, 0.25, 0.10]
    ),
    "cargo_type": np.random.choice(cargo_types, n_records),
    "distance_km": np.random.randint(100, 1800, n_records),
    "weight_kg": np.random.randint(100, 20000, n_records)
})

# ==================================================
# 4. SIMULATE SEASONAL FREIGHT DEMAND
# ==================================================
month = df["shipment_date"].dt.month

seasonal_factor = np.where(
    month.isin([10, 11, 12]), 1.30,
    np.where(month.isin([6, 7, 8]), 0.90, 1.0)
)

df["demand_units"] = np.maximum(
    1,
    np.round(
        np.random.normal(100, 20, n_records) * seasonal_factor
    )
).astype(int)

# ==================================================
# 5. CALCULATE FREIGHT COST
# ==================================================
mode_rate = df["transport_mode"].map({
    "Truck": 12,
    "Rail": 7,
    "Air": 35
})

df["freight_cost"] = (
    df["distance_km"] * mode_rate
    + df["weight_kg"] * 0.15
).round(2)

# ==================================================
# 6. SIMULATE DELIVERY INFORMATION
# ==================================================
df["delivery_days"] = np.maximum(
    1,
    np.round(
        df["distance_km"] / 350
        + np.random.normal(1, 1.5, n_records)
    )
).astype(int)

df["delivery_status"] = np.where(
    df["delivery_days"] > 5, "Delayed", "On Time"
)

df["region"] = df["route"].map(route_regions)

# ==================================================
# 7. INTRODUCE DATA INCONSISTENCIES
# ==================================================

# A. Missing values
for column, fraction, seed in [
    ("weight_kg", 0.02, 10),
    ("freight_cost", 0.015, 11),
    ("delivery_days", 0.01, 12),
    ("route", 0.01, 13),
    ("delivery_status", 0.01, 14)
]:
    indexes = df.sample(
        frac=fraction, random_state=seed
    ).index
    df.loc[indexes, column] = np.nan

# B. Missing and invalid dates
# Convert dates to strings so invalid values can be represented
df["shipment_date"] = df["shipment_date"].dt.strftime("%Y-%m-%d")

date_indexes = df.sample(frac=0.01, random_state=15).index
df.loc[date_indexes, "shipment_date"] = np.nan

invalid_date_indexes = df.dropna(
    subset=["shipment_date"]
).sample(frac=0.005, random_state=16).index

df.loc[invalid_date_indexes, "shipment_date"] = "2025-15-40"

# C. Inconsistent text formats
text_indexes = df.sample(frac=0.03, random_state=17).index
df.loc[text_indexes, "transport_mode"] = "truck "

text_indexes = df.sample(frac=0.02, random_state=18).index
df.loc[text_indexes, "cargo_type"] = "electronics"

text_indexes = df.sample(frac=0.015, random_state=19).index
df.loc[text_indexes, "delivery_status"] = "on time "

# D. Invalid categories
invalid_mode_indexes = df.sample(frac=0.005, random_state=21).index
df.loc[invalid_mode_indexes, "transport_mode"] = "Helicopter"

invalid_cargo_indexes = df.sample(frac=0.005, random_state=22).index
df.loc[invalid_cargo_indexes, "cargo_type"] = "Unknown Cargo"

# E. Invalid numerical values
weight_indexes = df.sample(frac=0.005, random_state=23).index
df.loc[weight_indexes, "weight_kg"] = -500

distance_indexes = df.sample(frac=0.005, random_state=24).index
df.loc[distance_indexes, "distance_km"] = 0

delivery_indexes = df.sample(frac=0.005, random_state=25).index
df.loc[delivery_indexes, "delivery_days"] = -3

demand_indexes = df.sample(frac=0.005, random_state=26).index
df.loc[demand_indexes, "demand_units"] = -10

# F. Wrong data types / text in numeric columns
df["distance_km"] = df["distance_km"].astype(object)
distance_text_indexes = df.sample(frac=0.01, random_state=27).index
df.loc[distance_text_indexes, "distance_km"] = "unknown"

df["weight_kg"] = df["weight_kg"].astype(object)
weight_text_indexes = df.sample(frac=0.005, random_state=28).index
df.loc[weight_text_indexes, "weight_kg"] = "not available"

# G. Invalid shipment IDs
missing_id_indexes = df.sample(frac=0.003, random_state=29).index
df.loc[missing_id_indexes, "shipment_id"] = np.nan

# H. Extreme freight-cost outliers
cost_indexes = df.sample(n=5, random_state=30).index
df.loc[cost_indexes, "freight_cost"] = (
    pd.to_numeric(df.loc[cost_indexes, "freight_cost"], errors="coerce")
    * 100
)

# I. Duplicate records
duplicate_rows = df.sample(n=10, random_state=31)
df = pd.concat([df, duplicate_rows], ignore_index=True)

# ==================================================
# 8. SAVE RAW DATASET
# ==================================================
output_dir = Path("01_dataset_creation")
output_dir.mkdir(parents=True, exist_ok=True)

output_file = output_dir / "raw_freight_data.csv"
df.to_csv(output_file, index=False)

# ==================================================
# 9. VERIFY DATASET
# ==================================================
print("=" * 55)
print("SYNTHETIC LOGISTICS DATASET CREATED")
print("=" * 55)

print("\nDataset shape:", df.shape)
print("\nColumn names:")
print(df.columns.tolist())

print("\nFirst 5 rows:")
print(df.head())

print("\nMissing values per column:")
print(df.isnull().sum())

print("\nData types:")
print(df.dtypes)

print("\nDuplicate rows:", df.duplicated().sum())

print("\nDate range (valid dates only):")
valid_dates = pd.to_datetime(
    df["shipment_date"], errors="coerce"
)
print(valid_dates.min(), "to", valid_dates.max())

print("\nSaved file:", output_file)
print("\nNext step: Data cleaning")
